# Copy this to .env and fill in your values

# MongoDB Connection URI
# Local:  mongodb://localhost:27017/shop_management
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/shop_management
MONGO_URI=mongodb://localhost:27017/shop_management

# MongoDB Database Name
MONGO_DB=shop_management

# JWT Secret (use a long random string in production — minimum 32 characters)
JWT_SECRET=yourVeryLongAndSecureRandomSecretKeyHere2024AtLeast32Chars

# JWT Token expiry in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Server port (default: 8080)
PORT=8080

# Copy this to .env and fill in your values

# ─── Local vs Atlas toggle ──────────────────────────────────────────────────
# "local" starts a bundled MongoDB container and points the backend at it.
# For MongoDB Atlas: leave this empty (no local DB) and set MONGO_URI below.
COMPOSE_PROFILES=local

# ─── MongoDB Connection ─────────────────────────────────────────────────────
# Local (bundled container, COMPOSE_PROFILES=local):
#   mongodb://mongo:27017/shop_management        <-- default, leave MONGO_URI unset
# Atlas (COMPOSE_PROFILES empty): paste your SRV string, URL-encode special chars in the password:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/shop_management?retryWrites=true&w=majority
MONGO_URI=

# MongoDB Database Name
MONGO_DB=shop_management

# ─── JWT ────────────────────────────────────────────────────────────────────
# Use a long random string in production — minimum 32 characters.
JWT_SECRET=yourVeryLongAndSecureRandomSecretKeyHere2024AtLeast32Chars

# JWT Token expiry in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Server port (default: 8080)
PORT=8080

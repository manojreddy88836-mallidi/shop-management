# Frontend environment variables
# Copy this to .env in the frontend/ directory

# Backend API URL (leave empty to use Nginx proxy when running in Docker)
# For Vercel/Netlify deployment, set this to your backend URL:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# Render Docker deployment: set BACKEND_URL on the frontend service to the
# backend's public URL, for example https://shop-management-backend.onrender.com
# This is used by Nginx at container startup when VITE_API_URL is empty.
# BACKEND_URL=https://your-backend.onrender.com
